{
	"name": "refinr-obsidian",
	"version": "0.1.0",
	"private": true,
	"description": "Obsidian plugin for Refinr: turn the active note into an agent-ready backlog in Jira or OpenProject.",
	"main": "main.js",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "vitest run",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@types/node": "22.20.5",
		"esbuild": "0.28.2",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.5.1",
		"globals": "17.14.0",
		"jiti": "2.7.0",
		"obsidian": "1.14.4",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.2",
		"vitest": "5.1.0"
	}
}
